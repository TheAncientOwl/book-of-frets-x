---
/**
 * --------------------------------------------------------------------------- *
 *                     Copyright (c) by BookOfFrets 2026                       *
 * --------------------------------------------------------------------------- *
 * @license https://github.com/TheAncientOwl/book-of-frets-x/blob/main/LICENSE
 * @file AboutPage.astro
 * @author Alexandru Delegeanu
 * @version 1.7
 * @description App homepage containing project details, features, and core motivations.
 */

import '#styles/global.css';

import AboutLayout from '#layouts/AboutLayout.astro';
---

<AboutLayout>
  <div class='bg-deep-charcoal min-h-dvh flex flex-col'>
    <div
      id='about-page-container'
      class='w-full h-full min-h-dvh px-4 py-6 flex flex-col md:rounded-xl max-w-full md:max-w-4xl mx-auto bg-deep-purple shadow-2xl overflow-y-auto text-magenta/90'
    >
      <h1
        class='text-center font-bold text-2xl sm:text-3xl md:text-4xl mb-6 text-gold tracking-wide'
      >
        Book Of Frets
      </h1>

      <div class='space-y-6 sm:space-y-8 text-sm sm:text-base leading-relaxed w-full'>
        <div class='w-full'>
          <p class='w-full text-left break-words'>
            BookOfFrets is a web-based application designed to help guitar enthusiasts learn and
            explore songs through an interactive fretboard. It features a comprehensive collection
            of songs with detailed frets, strumming patterns, chords,{' '}
            <a
              href='/chords'
              class='text-gold/90 font-medium no-underline hover:opacity-80 transition-opacity'
            >
              chords list
            </a>
            ,{' '}
            <a
              href='/'
              class='text-gold/90 font-medium no-underline hover:opacity-80 transition-opacity'
            >
              songs list
            </a>
            ,{' '}
            <a
              href='/fretboard'
              class='text-gold/90 font-medium no-underline hover:opacity-80 transition-opacity'
            >
              fretboard
            </a>
            ,{' '}
            <a
              href='/practice'
              class='text-gold/90 font-medium no-underline hover:opacity-80 transition-opacity'
            >
              practice pages
            </a>
            , and customizable{' '}
            <a
              href='/settings'
              class='text-gold/90 font-medium no-underline hover:opacity-80 transition-opacity'
            >
              themes
            </a>
            .
          </p>
        </div>

        <hr class='border-purple-900/40 w-full' />

        <div class='w-full'>
          <h2 class='text-lg sm:text-xl font-bold mb-4 text-gold/90 flex items-center gap-2'>
            <span>✨</span> Features
          </h2>
          <div class='grid grid-cols-1 sm:grid-cols-2 gap-3 w-full'>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>🎵</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Songs with Frets:</span> Visualize songs with
                precise fret positions to help you learn finger placements.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>🎼</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Chords:</span> Access a rich library of chords
                with clear diagrams.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>📖</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Chords List:</span> Browse and search through
                a curated list of chords.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>📂</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Songs List:</span> Easily navigate through
                a growing collection of songs.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>🎸</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Interactive Fretboard:</span> Explore notes,
                scales, and fingerings directly on an interactive fretboard layout.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>🎯</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Practice Tools:</span> Enhance your skills
                with dedicated training modes and practice views.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>🎨</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Themes:</span> Customize the look and feel
                of the app with various themes.
              </p>
            </div>
            <div
              class='bg-deep-charcoal/30 p-3.5 rounded-lg border border-purple-950/40 flex items-start gap-2.5'
            >
              <span class='text-gold/90 text-sm mt-0.5'>📺</span>
              <p class='text-magenta/80 text-sm sm:text-base break-words m-0'>
                <span class='font-semibold text-magenta/90'>Video Resources:</span> Learn how to play
                songs with helpful video tutorials.
              </p>
            </div>
          </div>
        </div>

        <hr class='border-purple-900/40 w-full' />

        <div class='w-full'>
          <h2 class='text-lg sm:text-xl font-bold mb-3 text-gold/90 flex items-center gap-2'>
            <span>🛠️</span> Main Feature
          </h2>
          <p class='text-magenta/80 break-words w-full'>
            BookOfFrets is easily configurable via JSON files, allowing users and contributors to
            add new songs, chords, and themes without modifying the core code. This extensibility
            makes it simple to expand the app's content and tailor it to your preferences.
          </p>
        </div>

        <hr class='border-purple-900/40 w-full' />

        <div class='w-full'>
          <h2 class='text-lg sm:text-xl font-bold mb-3 text-gold/90 flex items-center gap-2'>
            <span>🎶</span> Motivation
          </h2>
          <p class='text-magenta/80 break-words w-full'>
            As a guitar learner, I found myself frustrated with the tedious process of writing
            chords and songs by hand. I wanted a prettier, more extensible solution that could grow
            with my learning journey. BookOfFrets was born out of this desire to create an intuitive
            and visually appealing tool that makes learning guitar more enjoyable and accessible.
          </p>
        </div>

        <hr class='border-purple-900/40 w-full' />

        <div class='w-full'>
          <h2 class='text-lg sm:text-xl font-bold mb-3 text-gold/90 flex items-center gap-2'>
            <span>🤝</span> Contribution
          </h2>
          <p class='text-magenta/80 break-words w-full'>
            <a
              href='https://github.com/TheAncientOwl/book-of-frets-x/blob/main/CONTRIBUTING.md'
              target='_blank'
              rel='noopener noreferrer'
              class='text-gold/90 font-medium no-underline mr-1 hover:opacity-80 transition-opacity'
            >
              Contributions
            </a>
            are welcome and encouraged! If you have new songs, chords, or themes to share, please submit
            a pull request. There are plenty of songs to showcase theme/chord/song configuration! Help
            us make BookOfFrets better for everyone.
          </p>
        </div>

        <hr class='border-purple-900/40 w-full' />

        <div class='w-full'>
          <h2 class='text-lg sm:text-xl font-bold mb-3 text-gold/90 flex items-center gap-2'>
            <span>📜</span> License
          </h2>
          <p class='text-magenta/80 break-words w-full'>
            This project is licensed under the{' '}
            <a
              href='https://github.com/TheAncientOwl/book-of-frets/blob/main/LICENSE'
              target='_blank'
              rel='noopener noreferrer'
              class='text-gold/90 font-medium no-underline hover:opacity-80 transition-opacity'
            >
              MIT License
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </div>
</AboutLayout>
