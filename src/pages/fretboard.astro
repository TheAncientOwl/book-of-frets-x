import '#styles/global.css';
import { Icon } from 'astro-icon/components';
import PageHeader from '#components/common/PageHeader.astro';
import Fretboard from '#components/common/Fretboard.astro';
import GeneralLayout from '#layouts/GeneralLayout.astro';
---

<GeneralLayout>
  <div class='bg-(--theme-page) min-h-dvh flex justify-center text-(--theme-text)'>
    <div
      class='w-full max-w-xl flex flex-col items-center bg-(--theme-surface) p-6 rounded-xl shadow-2xl'
    >
      <PageHeader>
        <Icon name='game-icons:guitar' class='w-5.5 h-5.5 text-(--theme-accent-strong)/80' />
        Fretboard
      </PageHeader>
      <Fretboard id='fretboard' />
    </div>
  </div>
</GeneralLayout>
