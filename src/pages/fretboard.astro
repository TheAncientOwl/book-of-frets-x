import '#styles/global.css';
import { Icon } from 'astro-icon/components';
import PageHeader from '#components/common/PageHeader.astro';
import Fretboard from '#components/common/Fretboard.astro';
import FretboardLayout from '#layouts/FretboardLayout.astro';
---

<FretboardLayout>
  <div class='bg-deep-charcoal min-h-dvh flex justify-center text-white'>
    <div
      class='w-full max-w-xl flex flex-col items-center bg-deep-purple p-6 rounded-xl shadow-2xl'
    >
      <PageHeader>
        <Icon name='game-icons:guitar' class='w-5.5 h-5.5 text-purple-500/80' />
        Fretboard
      </PageHeader>
      <Fretboard id='fretboard' />
    </div>
  </div>
</FretboardLayout>
