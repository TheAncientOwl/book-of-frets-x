---
/**
 * --------------------------------------------------------------------------- *
 *                       Copyright (c) by BookOfFretsX 2026                    *
 * --------------------------------------------------------------------------- *
 * @license https://github.com/TheAncientOwl/book-of-frets-x/blob/main/LICENSE
 * @file practice.astro
 * @author Alexandru Delegeanu
 * @version 1.7
 * @description Practice helpers with compact action buttons and scaled display text
 */

import '#styles/global.css';
import '#components/common/checkbox.css';

import { Icon } from 'astro-icon/components';
import IconButton from '#components/common/IconButton.astro';
import PageHeader from '#components/common/PageHeader.astro';
import Fretboard from '#components/common/Fretboard.astro';
import PracticeGameTabs from '#components/practice/PracticeGameTabs.astro';
import NotePracticeGame from '#components/practice/NotePracticeGame.astro';
import NoteStringPracticeGame from '#components/practice/NoteStringPracticeGame.astro';
import FretCoordinatePracticeGame from '#components/practice/FretCoordinatePracticeGame.astro';
import GeneralLayout from '#layouts/GeneralLayout.astro';
---

<GeneralLayout>
  <div class='bg-deep-charcoal min-h-dvh flex flex-col items-center text-white'>
    <div
      class='w-full max-w-xl min-h-dvh flex flex-col items-center bg-deep-purple p-3 sm:p-6 pt-6 rounded-xl shadow-2xl'
    >
      <PageHeader>
        <Icon name='material-symbols:track-changes' class='w-[22px] h-[22px] text-purple-500/80' />
        Practice
        <IconButton slot='action' label='Settings' onclick='openActiveSettingsModal()'>
          <Icon name='material-symbols:settings' class='w-[20px] h-[20px]' />
        </IconButton>
      </PageHeader>

      <p class='text-gray-400 text-sm mb-6 text-center'>
        Sharpen your fretboard fluency with targeted random prompts.
      </p>

      <PracticeGameTabs />
      <NotePracticeGame />
      <NoteStringPracticeGame />
      <FretCoordinatePracticeGame />
    </div>
  </div>

  {/* ========================================================= */}
  {/* MODAL 1: NOTE CONFIGURATION                               */}
  {/* ========================================================= */}
  <div
    id='notes-modal'
    class='fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4'
  >
    <div
      class='bg-[#1e192f] border border-purple-900/60 w-full max-w-lg rounded-xl p-6 shadow-2xl flex flex-col'
    >
      <div class='flex justify-between items-center mb-4'>
        <h3 class='text-lg font-bold text-amber-400'>Configure Notes</h3>
        <button
          onclick='closeModal("notes-modal")'
          class='text-gray-400 hover:text-white text-lg cursor-pointer flex items-center'
        >
          <Icon name='material-symbols:close' class='w-[20px] h-[20px]' />
        </button>
      </div>

      {/* Notes Count Configuration Input */}
      <div class='mb-5 bg-deep-charcoal/50 p-3.5 rounded-lg border border-purple-900/40'>
        <label
          for='notes-count-input'
          class='mb-1 block text-xs font-semibold text-gray-300 uppercase tracking-wide'
        >
          Max Notes Per Prompt
        </label>
        <div class='flex w-full'>
          <button
            type='button'
            data-step-target='notes-count-input'
            data-step-direction='-1'
            aria-label='Decrease max notes per prompt'
            title='Decrease max notes per prompt'
            class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
          >
            <Icon name='material-symbols:remove' class='w-5 h-5' />
          </button>
          <input
            type='number'
            id='notes-count-input'
            min='1'
            max='17'
            step='1'
            value='1'
            onchange='updateNotesCount(this.value)'
            class='number-stepper-input min-w-0 w-full appearance-none bg-deep-charcoal border-y border-purple-800/60 p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:outline-none focus:border-amber-400'
          />
          <button
            type='button'
            data-step-target='notes-count-input'
            data-step-direction='1'
            aria-label='Increase max notes per prompt'
            title='Increase max notes per prompt'
            class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
          >
            <Icon name='material-symbols:add' class='w-5 h-5' />
          </button>
        </div>
      </div>

      <div class='flex justify-between items-center mb-2'>
        <span class='text-xs font-semibold text-gray-300 uppercase tracking-wide'
          >Configure Available Notes</span
        >
        <div class='space-x-2 text-xs'>
          <button
            onclick='toggleAllNotes(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            onclick='toggleAllNotes(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>

      <div id='notes-checkboxes' class='grid grid-cols-3 gap-2 mb-2'></div>
    </div>
  </div>

  {/* ========================================================= */}
  {/* MODAL 2: NOTES & STRINGS CONFIGURATION                    */}
  {/* ========================================================= */}
  <div
    id='strings-modal'
    class='fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4'
  >
    <div
      class='bg-[#1e192f] border border-purple-900/60 w-full max-w-lg rounded-xl p-6 shadow-2xl flex flex-col max-h-[90vh] overflow-y-auto'
    >
      <div class='flex justify-between items-center mb-4'>
        <h3 class='text-lg font-bold text-amber-400'>Configure Notes & Strings</h3>
        <button
          onclick='closeModal("strings-modal")'
          class='text-gray-400 hover:text-white text-lg cursor-pointer flex items-center'
        >
          <Icon name='material-symbols:close' class='w-[20px] h-[20px]' />
        </button>
      </div>

      <div class='mb-4 grid grid-cols-2 gap-3'>
        <div class='min-w-0'>
          <label
            for='strings-count-input'
            class='mb-1 block min-h-8 text-[10px] font-semibold leading-4 tracking-wide text-gray-300 uppercase sm:text-xs'
          >
            Max Combos Per Prompt
          </label>
          <div class='flex w-full'>
            <button
              type='button'
              data-step-target='strings-count-input'
              data-step-direction='-1'
              aria-label='Decrease max combos per prompt'
              title='Decrease max combos per prompt'
              class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
            >
              <Icon name='material-symbols:remove' class='w-5 h-5' />
            </button>
            <input
              type='number'
              id='strings-count-input'
              min='1'
              max='20'
              step='1'
              value='1'
              onchange='updateStringsCount(this.value)'
              class='number-stepper-input min-w-0 w-full appearance-none bg-deep-charcoal border-y border-purple-800/60 p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:outline-none focus:border-amber-400'
            />
            <button
              type='button'
              data-step-target='strings-count-input'
              data-step-direction='1'
              aria-label='Increase max combos per prompt'
              title='Increase max combos per prompt'
              class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
            >
              <Icon name='material-symbols:add' class='w-5 h-5' />
            </button>
          </div>
        </div>

        <div class='min-w-0'>
          <label
            for='strings-tolerance-input'
            class='mb-1 block min-h-8 text-[10px] font-semibold leading-4 tracking-wide text-gray-300 uppercase sm:text-xs'
          >
            Pitch Tolerance
          </label>
          <div class='flex w-full'>
            <button
              type='button'
              data-step-target='strings-tolerance-input'
              data-step-direction='-1'
              aria-label='Decrease pitch tolerance'
              title='Decrease pitch tolerance'
              class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
            >
              <Icon name='material-symbols:remove' class='w-5 h-5' />
            </button>
            <input
              type='number'
              id='strings-tolerance-input'
              min='5'
              max='100'
              step='5'
              value='35'
              onchange='updatePitchTolerance(this.value)'
              class='number-stepper-input min-w-0 w-full appearance-none bg-deep-charcoal border-y border-purple-800/60 p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:outline-none focus:border-amber-400'
            />
            <button
              type='button'
              data-step-target='strings-tolerance-input'
              data-step-direction='1'
              aria-label='Increase pitch tolerance'
              title='Increase pitch tolerance'
              class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
            >
              <Icon name='material-symbols:add' class='w-5 h-5' />
            </button>
          </div>
        </div>
      </div>

      <div class='flex justify-between items-center mb-2'>
        <span class='text-xs font-semibold text-gray-300 uppercase tracking-wide'
          >Configure Strings</span
        >
        <div class='space-x-2 text-xs'>
          <button
            onclick='toggleAllStrings(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            onclick='toggleAllStrings(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>
      <div id='string-checkboxes' class='grid grid-cols-3 gap-2 mb-4'></div>

      <div class='flex justify-between items-center mb-2'>
        <span class='text-xs font-semibold text-gray-300 uppercase tracking-wide'
          >Configure Notes</span
        >
        <div class='space-x-2 text-xs'>
          <button
            onclick='toggleAllStringNotes(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            onclick='toggleAllStringNotes(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>
      <div id='string-notes-checkboxes' class='grid grid-cols-3 gap-2 mb-2'></div>
    </div>
  </div>
</GeneralLayout>

<div
  id='coordinate-modal'
  class='fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4'
>
  <div
    class='w-full max-w-lg max-h-[90dvh] overflow-y-auto rounded-xl border border-purple-900/60 bg-[#1e192f] p-6 shadow-2xl'
  >
    <div class='mb-5 flex items-center justify-between gap-4'>
      <h3 class='text-lg font-bold text-amber-400'>Fret Quiz Settings</h3>
      <button
        type='button'
        onclick='closeModal("coordinate-modal")'
        aria-label='Close Fret Quiz settings'
        class='flex h-9 w-9 items-center justify-center rounded-md text-gray-300 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
      >
        <Icon name='material-symbols:close' class='w-5 h-5' />
      </button>
    </div>
    <label
      for='coordinate-question-count'
      class='mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-300'
    >
      Questions per quiz
    </label>
    <div class='flex w-full'>
      <button
        type='button'
        data-step-target='coordinate-question-count'
        data-step-direction='-1'
        aria-label='Decrease questions per quiz'
        class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
      >
        <Icon name='material-symbols:remove' class='w-5 h-5' />
      </button>
      <input
        type='number'
        id='coordinate-question-count'
        min='1'
        max='50'
        step='1'
        value='10'
        onchange='updateCoordinateQuestionCount(this.value)'
        class='number-stepper-input min-w-0 w-full appearance-none border-y border-purple-800/60 bg-deep-charcoal p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:border-amber-400 focus:outline-none'
      />
      <button
        type='button'
        data-step-target='coordinate-question-count'
        data-step-direction='1'
        aria-label='Increase questions per quiz'
        class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
      >
        <Icon name='material-symbols:add' class='w-5 h-5' />
      </button>
    </div>

    <label
      for='coordinate-max-fret'
      class='mb-1 mt-4 block text-xs font-semibold uppercase tracking-wide text-gray-300'
    >
      Max fret
    </label>
    <div class='flex w-full'>
      <button
        type='button'
        data-step-target='coordinate-max-fret'
        data-step-direction='-1'
        aria-label='Decrease maximum fret'
        class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
      >
        <Icon name='material-symbols:remove' class='w-5 h-5' />
      </button>
      <input
        type='number'
        id='coordinate-max-fret'
        min='0'
        max='24'
        step='1'
        value='24'
        onchange='updateCoordinateMaxFret(this.value)'
        class='number-stepper-input min-w-0 w-full appearance-none border-y border-purple-800/60 bg-deep-charcoal p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:border-amber-400 focus:outline-none'
      />
      <button
        type='button'
        data-step-target='coordinate-max-fret'
        data-step-direction='1'
        aria-label='Increase maximum fret'
        class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
      >
        <Icon name='material-symbols:add' class='w-5 h-5' />
      </button>
    </div>

    <div class='mt-5'>
      <div class='mb-2 flex items-center justify-between'>
        <span class='text-xs font-semibold uppercase tracking-wide text-gray-300'
          >Configure Strings</span
        >
        <div class='space-x-2 text-xs'>
          <button
            type='button'
            onclick='toggleAllCoordinateStrings(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            type='button'
            onclick='toggleAllCoordinateStrings(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>
      <div id='coordinate-string-checkboxes' class='grid grid-cols-3 gap-2'></div>
    </div>

    <div class='mt-5'>
      <div class='mb-2 flex items-center justify-between'>
        <span class='text-xs font-semibold uppercase tracking-wide text-gray-300'
          >Configure Notes</span
        >
        <div class='space-x-2 text-xs'>
          <button
            type='button'
            onclick='toggleAllCoordinateNotes(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            type='button'
            onclick='toggleAllCoordinateNotes(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>
      <div id='coordinate-note-checkboxes' class='grid grid-cols-3 gap-2'></div>
    </div>
  </div>
</div>

<div
  id='practice-fretboard-modal'
  class='fixed inset-0 bg-black/75 backdrop-blur-sm z-50 flex items-center justify-center hidden p-3 sm:p-5'
>
  <div
    role='dialog'
    aria-modal='true'
    aria-label='Fretboard'
    class='relative w-full max-w-lg max-h-[92dvh] bg-deep-purple border border-purple-900/60 rounded-xl shadow-2xl flex flex-col overflow-hidden'
  >
    <button
      type='button'
      data-close-practice-fretboard
      aria-label='Close fretboard popup'
      class='absolute top-2 right-2 z-10 flex h-9 w-9 items-center justify-center rounded-md text-gray-300 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
    >
      <Icon name='material-symbols:close' class='w-5 h-5' />
    </button>
    <div class='min-h-0 overflow-y-auto px-2 pb-2 pt-12 sm:px-3 sm:pb-3'>
      <Fretboard
        id='practice-fretboard'
        showControls={false}
        compact={true}
        persist={false}
        interactive={false}
      />
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      openModal: (id: string) => void;
      closeModal: (id: string) => void;
      openActiveSettingsModal: () => void;
      switchTab: (tab: 'notes' | 'strings' | 'coordinates', save?: boolean) => void;
      updateNoteState: (idx: number, val: boolean) => void;
      updateNotesCount: (val: string) => void;
      updateStringsCount: (val: string) => void;
      updatePitchTolerance: (val: string) => void;
      updateCoordinateQuestionCount: (val: string) => void;
      updateStringState: (idx: number, val: boolean) => void;
      updateStringNoteState: (idx: number, val: boolean) => void;
      toggleAllNotes: (val: boolean) => void;
      toggleAllStrings: (val: boolean) => void;
      toggleAllStringNotes: (val: boolean) => void;
      startNotesGame: () => void;
      startStringsGame: () => void | Promise<void>;
      startCoordinateQuiz: () => void;
      nextCoordinateQuestion: () => void;
      toggleStringsMic: () => void;
    }
  }

  interface NoteConfig {
    label: string;
    checked: boolean;
  }

  interface StringConfig {
    label: string;
    name: string;
    checked: boolean;
  }

  const ICONS = {
    checkCircle: `<svg class="w-[18px] h-[18px] text-green-400 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>`,
    refresh: `<svg class="w-[16px] h-[16px] fill-current" viewBox="0 0 24 24"><path d="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>`,
    mic: `<svg class="w-[15px] h-[15px] fill-current" viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/><path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>`,
    micOff: `<svg class="w-[15px] h-[15px] fill-current" viewBox="0 0 24 24"><path d="M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99zM4.27 3L3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c1.33-.19 2.53-.73 3.52-1.5l2.21 2.21L20 17.36 4.27 3z"/></svg>`,
  };

  const defaultNotes: NoteConfig[] = [
    { label: 'A', checked: true },
    { label: 'A♯', checked: true },
    { label: 'B♭', checked: true },
    { label: 'B', checked: true },
    { label: 'C', checked: true },
    { label: 'C♯', checked: true },
    { label: 'D♭', checked: true },
    { label: 'D', checked: true },
    { label: 'D♯', checked: true },
    { label: 'E♭', checked: true },
    { label: 'E', checked: true },
    { label: 'F', checked: true },
    { label: 'F♯', checked: true },
    { label: 'G♭', checked: true },
    { label: 'G', checked: true },
    { label: 'G♯', checked: true },
    { label: 'A♭', checked: true },
  ];

  const defaultStrings: StringConfig[] = [
    {
      label: 'E <span class="text-[10px] text-gray-400">(low)</span>',
      name: 'E <span class="text-[0.5em] opacity-75 font-normal">(low)</span>',
      checked: true,
    },
    { label: 'A', name: 'A', checked: true },
    { label: 'D', name: 'D', checked: true },
    { label: 'G', name: 'G', checked: true },
    { label: 'B', name: 'B', checked: true },
    {
      label: 'E <span class="text-[10px] text-gray-400">(high)</span>',
      name: 'E <span class="text-[0.5em] opacity-75 font-normal">(high)</span>',
      checked: true,
    },
  ];

  let notesState: NoteConfig[] = loadState('bof_notes_state', defaultNotes);

  let stringNotesState: NoteConfig[] = loadState('bof_string_notes_state', defaultNotes);

  let stringsState: StringConfig[] = loadState('bof_strings_state', defaultStrings);

  let coordinateNotesState: NoteConfig[] = loadState('bof_coordinate_notes_state', defaultNotes);

  let coordinateStringsState: StringConfig[] = loadState(
    'bof_coordinate_strings_state',
    defaultStrings,
  );

  let notesCountSetting: number = parseInt(
    localStorage.getItem('bof_notes_count_setting') || '1',
    10,
  );

  let stringsCountSetting: number = parseInt(
    localStorage.getItem('bof_strings_count_setting') || '1',
    10,
  );

  let pitchToleranceSetting: number = parseInt(
    localStorage.getItem('bof_pitch_tolerance_setting') || '35',
    10,
  );

  let coordinateQuestionCountSetting = Math.max(
    1,
    Math.min(50, parseInt(localStorage.getItem('bof_coordinate_question_count') || '10', 10) || 10),
  );

  const savedCoordinateMaxFret = parseInt(
    localStorage.getItem('bof_coordinate_max_fret') ?? '24',
    10,
  );

  let coordinateMaxFretSetting = Number.isNaN(savedCoordinateMaxFret)
    ? 24
    : Math.max(0, Math.min(24, savedCoordinateMaxFret));

  function loadState<T>(key: string, fallback: T): T {
    try {
      const saved = localStorage.getItem(key);

      return saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(fallback));
    } catch (e) {
      return JSON.parse(JSON.stringify(fallback));
    }
  }

  function saveState(key: string, data: any): void {
    try {
      localStorage.setItem(key, JSON.stringify(data));
    } catch (e) {
      console.error('Failed to save state to localStorage', e);
    }
  }

  function initUI(): void {
    renderNotesModalCheckboxes();
    renderStringModalCheckboxes();
    renderCoordinateSettings();

    const notesCountInput = document.getElementById('notes-count-input') as HTMLInputElement;

    if (notesCountInput) {
      notesCountInput.value = notesCountSetting.toString();
    }

    const stringsCountInput = document.getElementById('strings-count-input') as HTMLInputElement;

    if (stringsCountInput) {
      stringsCountInput.value = stringsCountSetting.toString();
    }

    const toleranceInput = document.getElementById('strings-tolerance-input') as HTMLInputElement;

    if (toleranceInput) {
      toleranceInput.value = pitchToleranceSetting.toString();
    }

    const coordinateQuestionCountInput = document.getElementById(
      'coordinate-question-count',
    ) as HTMLInputElement | null;
    if (coordinateQuestionCountInput) {
      coordinateQuestionCountInput.value = coordinateQuestionCountSetting.toString();
    }

    const coordinateMaxFretInput = document.getElementById(
      'coordinate-max-fret',
    ) as HTMLInputElement | null;
    if (coordinateMaxFretInput) {
      coordinateMaxFretInput.value = coordinateMaxFretSetting.toString();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-step-target]').forEach(button => {
      button.addEventListener('click', () => {
        const input = document.getElementById(
          button.dataset.stepTarget ?? '',
        ) as HTMLInputElement | null;

        if (!input) return;

        const minimum = Number(input.min);
        const maximum = Number(input.max);
        const step = Number(input.step) || 1;
        const direction = Number(button.dataset.stepDirection);
        const nextValue = Math.max(
          minimum,
          Math.min(maximum, Number(input.value) + direction * step),
        );

        input.value = nextValue.toString();
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    const stringsDisplay = document.getElementById('strings-display');
    const fretboardModal = document.getElementById('practice-fretboard-modal');
    const closeFretboardButton = fretboardModal?.querySelector<HTMLButtonElement>(
      '[data-close-practice-fretboard]',
    );
    let popupOpener: HTMLButtonElement | null = null;

    function closeFretboardPopup() {
      fretboardModal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      popupOpener?.focus();
      popupOpener = null;
    }

    function openFretboardPopup(promptButton: HTMLButtonElement) {
      if (!fretboardModal) return;

      const note = promptButton.dataset.practiceFretboardNote;
      const stringValue = promptButton.dataset.practiceFretboardString;
      const stringIndex = stringValue === undefined ? null : Number(stringValue);
      if (!note || (stringValue !== undefined && !Number.isInteger(stringIndex))) return;

      popupOpener = promptButton;
      fretboardModal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      closeFretboardButton?.focus();
      window.dispatchEvent(
        new CustomEvent('fretboard:highlight', {
          detail: {
            rootId: 'practice-fretboard',
            note,
            stringIndex,
            useFlats: note.includes('♭') || note.endsWith('b'),
          },
        }),
      );
    }

    function handleFretboardPromptClick(event: Event) {
      const target = event.target as HTMLElement;
      const promptButton = target.closest<HTMLButtonElement>('[data-practice-fretboard-note]');
      if (promptButton) openFretboardPopup(promptButton);
    }

    document.getElementById('notes-display')?.addEventListener('click', handleFretboardPromptClick);
    stringsDisplay?.addEventListener('click', handleFretboardPromptClick);

    closeFretboardButton?.addEventListener('click', closeFretboardPopup);
    fretboardModal?.addEventListener('click', event => {
      if (event.target === fretboardModal) closeFretboardPopup();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !fretboardModal?.classList.contains('hidden')) {
        closeFretboardPopup();
      }
    });

    updateStringsMicToggle();

    const savedTab = localStorage.getItem('bof_active_tab') as
      'notes' | 'strings' | 'coordinates' | null;

    if (savedTab === 'strings') {
      (window as any).switchTab('strings', false);
    } else if (savedTab === 'coordinates') {
      (window as any).switchTab('coordinates', false);
    }
  }

  (window as any).openModal = function (id: string): void {
    document.getElementById(id)?.classList.remove('hidden');
  };

  (window as any).closeModal = function (id: string): void {
    document.getElementById(id)?.classList.add('hidden');
  };

  (window as any).openActiveSettingsModal = function (): void {
    const gameNotes = document.getElementById('game-notes');
    const gameStrings = document.getElementById('game-strings');
    const gameCoordinates = document.getElementById('game-coordinates');

    if (gameCoordinates?.style.display !== 'none') {
      (window as any).openModal('coordinate-modal');
    } else if (gameStrings?.style.display !== 'none') {
      (window as any).openModal('strings-modal');
    } else if (gameNotes && !gameNotes.classList.contains('hidden')) {
      (window as any).openModal('notes-modal');
    }
  };

  (window as any).switchTab = function (
    tab: 'notes' | 'strings' | 'coordinates',
    save: boolean = true,
  ): void {
    const tabNotes = document.getElementById('tab-notes');
    const tabStrings = document.getElementById('tab-strings');
    const tabCoordinates = document.getElementById('tab-coordinates');
    const gameNotes = document.getElementById('game-notes');
    const gameStrings = document.getElementById('game-strings');
    const gameCoordinates = document.getElementById('game-coordinates');

    if (
      !tabNotes ||
      !tabStrings ||
      !tabCoordinates ||
      !gameNotes ||
      !gameStrings ||
      !gameCoordinates
    ) {
      return;
    }

    const tabs = [
      { id: 'notes', button: tabNotes, panel: gameNotes },
      { id: 'strings', button: tabStrings, panel: gameStrings },
      { id: 'coordinates', button: tabCoordinates, panel: gameCoordinates },
    ] as const;
    tabs.forEach(({ id, button, panel }) => {
      const isActive = id === tab;
      button.className = isActive
        ? 'min-w-0 flex-1 px-1 py-2 text-xs sm:text-sm font-semibold rounded-md transition-colors bg-purple-700 text-white shadow cursor-pointer'
        : 'min-w-0 flex-1 px-1 py-2 text-xs sm:text-sm font-semibold rounded-md transition-colors text-gray-400 hover:text-white cursor-pointer';
      panel.style.display = isActive ? 'flex' : 'none';
    });

    if (save) {
      localStorage.setItem('bof_active_tab', tab);
    }
  };

  function renderCheckboxesIntoColumns(
    items: NoteConfig[],
    updateFnName: string,
    containerId: string,
  ): void {
    const container = document.getElementById(containerId);

    if (!container) return;

    container.innerHTML = '';

    const numCols = 3;

    const colLists: {
      item: NoteConfig;
      originalIndex: number;
    }[][] = Array.from({ length: numCols }, () => []);

    const itemsPerCol = Math.ceil(items.length / numCols);

    items.forEach((item, idx) => {
      const colIdx = Math.floor(idx / itemsPerCol);

      if (colLists[colIdx]) {
        colLists[colIdx].push({
          item,
          originalIndex: idx,
        });
      }
    });

    colLists.forEach(colItems => {
      let colHtml = `<div class="flex flex-col gap-2">`;

      colItems.forEach(({ item, originalIndex }) => {
        colHtml += `
              <label class="flex items-center gap-2 bg-deep-charcoal/60 p-2 rounded border border-purple-900/40 cursor-pointer hover:border-purple-700">
                <input type="checkbox" ${
                  item.checked ? 'checked' : ''
                } onchange="${updateFnName}(${originalIndex}, this.checked)" class="bof-checkbox bof-checkbox--standard">
                <span class="text-xs font-medium text-gray-200 cursor-pointer">${item.label}</span>
              </label>
            `;
      });

      colHtml += `</div>`;

      container.innerHTML += colHtml;
    });
  }

