import '#styles/global.css';

import ThemeSwitcher from '#components/ThemeSwitcher.astro';
import GeneralLayout from '#layouts/GeneralLayout.astro';
import { Icon } from 'astro-icon/components';
---

<GeneralLayout>
  <div class='min-h-dvh bg-(--theme-page) sm:px-4 text-(--theme-text)'>
    <section class='mx-auto w-full max-w-4xl rounded-xl bg-(--theme-surface) shadow-2xl'>
      <h1 class='pt-8 mb-8 text-center text-2xl font-bold text-(--theme-accent-text) sm:text-3xl'>
        <span class='flex items-center justify-center gap-2'>
          <Icon
            name='material-symbols:palette-outline'
            class='w-[22px] h-[22px] text-(--theme-accent-strong)/80'
          />
          Themes
        </span>
      </h1>
      <ThemeSwitcher />
    </section>
  </div>
</GeneralLayout>
