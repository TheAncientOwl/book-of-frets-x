          <svg viewBox='0 0 200 320' class='w-full h-full drop-shadow-2xl'>
            <defs>
              <linearGradient id='acousticWoodGrad' x1='0%' y1='0%' x2='100%' y2='100%'>
                <stop offset='0%' stop-color='#80543a'></stop>
                <stop offset='45%' stop-color='#4d3024'></stop>
                <stop offset='100%' stop-color='#271914'></stop>
