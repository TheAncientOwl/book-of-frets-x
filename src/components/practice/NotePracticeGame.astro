import { Icon } from 'astro-icon/components';
---

<div id='game-notes' class='w-full flex flex-col items-center'>
  <div
    class='w-full bg-deep-charcoal/80 rounded-xl py-6 px-4 flex flex-col items-center border border-purple-900/40 relative shadow-inner'
  >
    <div class='flex justify-center w-full mb-6'>
      <button
        id='notes-start-btn'
        onclick='startNotesGame()'
        class='py-2 px-5 bg-amber-400 hover:bg-amber-300 text-deep-charcoal font-bold rounded-lg shadow transition-all text-xs uppercase tracking-wider cursor-pointer flex items-center justify-center gap-1.5'
      >
        <span id='notes-btn-icon' class='flex items-center justify-center'>
          <Icon name='material-symbols:play-arrow' class='w-[16px] h-[16px]' />
        </span>
        <span id='notes-btn-text'>Start</span>
      </button>
    </div>

    <div id='notes-prompt-container' class='flex flex-col items-center justify-center w-full my-1'>
      <div class='h-6 flex items-center justify-center mb-3'>
        <span
          id='notes-status'
          class='text-xs uppercase tracking-widest text-purple-400 font-semibold text-center'
        >
          Find Note on All Strings
        </span>
      </div>
      <div
        id='notes-display'
        class='text-3xl sm:text-4xl font-black text-amber-400 tracking-wider flex items-center justify-center gap-3 flex-wrap px-2 text-center min-h-[88px]'
      >
        -
      </div>
    </div>
  </div>
</div>
