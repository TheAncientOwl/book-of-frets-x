import { Icon } from 'astro-icon/components';
---

<div id='game-coordinates' class='w-full flex-1 flex-col items-center' style='display: none'>
  <section
    class='w-full flex-1 py-6 px-4 flex flex-col rounded-xl border border-purple-900/40 bg-deep-charcoal/80'
  >
    <!-- Heading -->
    <div class='relative mb-6'>
      <!-- Progress -->
      <div id='coordinate-progress' class='absolute left-1 top-0 text-xs text-gray-500'>Ready</div>

      <!-- Target -->
      <div
        id='coordinate-question'
        class='text-xs sm:text-sm uppercase tracking-widest text-purple-400 font-semibold text-center mx-auto'
      >
        Identify notes on the neck
      </div>

      <!-- Score -->
      <span
        id='coordinate-score'
        class='absolute right-1 top-0 text-xs font-semibold text-amber-400'>Score 0</span
      >
    </div>

    <!-- Question -->
    <div
      id='coordinate-question-area'
      class='flex flex-col items-center justify-center text-center'
    >
      <p id='coordinate-feedback' role='status' aria-live='polite' class='text-sm text-gray-400'>
      </p>
    </div>

    <div id='coordinate-answers' class='h-30 grid grid-cols-2 gap-2 sm:gap-3'>
      <button
        type='button'
        disabled
        class='cursor-not-allowed rounded-md border border-purple-900/50 bg-deep-purple/70 px-4 py-3 text-lg font-bold text-amber-300/50 opacity-50'
      >
        ?
      </button>
      <button
        type='button'
        disabled
        class='cursor-not-allowed rounded-md border border-purple-900/50 bg-deep-purple/70 px-4 py-3 text-lg font-bold text-amber-300/50 opacity-50'
      >
        ?
      </button>
      <button
        type='button'
        disabled
        class='cursor-not-allowed rounded-md border border-purple-900/50 bg-deep-purple/70 px-4 py-3 text-lg font-bold text-amber-300/50 opacity-50'
      >
        ?
      </button>
      <button
        type='button'
        disabled
        class='cursor-not-allowed rounded-md border border-purple-900/50 bg-deep-purple/70 px-4 py-3 text-lg font-bold text-amber-300/50 opacity-50'
      >
        ?
      </button>
    </div>

    <!-- Results -->
    <div
      id='coordinate-results'
      style='display: none'
      class='text-center h-30'
      role='status'
      aria-live='polite'
    >
      <p class='text-xs font-semibold uppercase tracking-widest text-purple-400'>Quiz complete</p>
      <p id='coordinate-final-score' class='mt-3 text-4xl font-black text-amber-400'></p>
      <p class='mt-2 text-sm text-gray-400'>Correct answers</p>
    </div>

    <!-- Buttons -->
    <div class='mt-4 flex justify-center gap-2'>
      <!-- Start / Restart Button -->
      <button
        type='button'
        id='coordinate-start-btn'
        class='inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-amber-400 px-5 py-2 text-xs font-bold uppercase tracking-wider text-deep-charcoal shadow transition-colors hover:bg-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-200'
      >
        <Icon name='material-symbols:play-arrow' class='coordinate-start-play h-4 w-4' />
        <Icon name='material-symbols:refresh' class='coordinate-start-restart hidden h-4 w-4' />
        <span id='coordinate-start-label'>Start</span>
      </button>

      <!-- Next Button -->
      <button
        type='button'
        id='coordinate-next-btn'
        disabled
        class='hidden inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-purple-700/60 bg-purple-900/50 px-5 py-2 text-xs font-semibold text-purple-100 transition-colors hover:bg-purple-800/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400 disabled:cursor-not-allowed disabled:opacity-40'
      >
        <span id='coordinate-next-label'>Next question</span>
        <Icon name='material-symbols:arrow-forward' class='h-4 w-4' />
      </button>
    </div>
  </section>
</div>

<!-- ========================================================= -->
<!-- MODAL: CONFIGURATION                                      -->
<!-- ========================================================= -->
<div
  id='coordinate-modal'
  class='fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4'
>
  <div
    class='w-full max-w-lg max-h-[90dvh] overflow-y-auto rounded-xl border border-purple-900/60 bg-[#1e192f] p-6 shadow-2xl flex flex-col'
  >
    <div class='mb-4 flex items-center justify-between gap-4'>
      <h3 class='text-lg font-bold text-amber-400'>Fret Quiz Settings</h3>
      <button
        type='button'
        onclick='closeModal("coordinate-modal")'
        aria-label='Close Fret Quiz settings'
        class='flex h-9 w-9 items-center justify-center rounded-md text-gray-300 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
      >
        <Icon name='material-symbols:close' class='w-5 h-5' />
      </button>
    </div>

    <!-- 2-column Grid Layout for Inputs -->
    <div class='mb-4 grid grid-cols-2 gap-3'>
      <!-- Questions Per Quiz -->
      <div class='min-w-0'>
        <label
          for='coordinate-question-count'
          class='mb-1 block min-h-8 text-[10px] font-semibold leading-4 tracking-wide text-gray-300 uppercase sm:text-xs'
        >
          Questions per quiz
        </label>
        <div class='flex w-full'>
          <button
            type='button'
            data-step-target='coordinate-question-count'
            data-step-direction='-1'
            aria-label='Decrease questions per quiz'
            title='Decrease questions per quiz'
            class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
          >
            <Icon name='material-symbols:remove' class='w-5 h-5' />
          </button>
          <input
            type='number'
            id='coordinate-question-count'
            min='1'
            max='50'
            step='1'
            value='10'
            onchange='updateCoordinateQuestionCount(this.value)'
            class='number-stepper-input min-w-0 w-full appearance-none bg-deep-charcoal border-y border-purple-800/60 p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:outline-none focus:border-amber-400'
          />
          <button
            type='button'
            data-step-target='coordinate-question-count'
            data-step-direction='1'
            aria-label='Increase questions per quiz'
            title='Increase questions per quiz'
            class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
          >
            <Icon name='material-symbols:add' class='w-5 h-5' />
          </button>
        </div>
      </div>

      <!-- Max Fret -->
      <div class='min-w-0'>
        <label
          for='coordinate-max-fret'
          class='mb-1 block min-h-8 text-[10px] font-semibold leading-4 tracking-wide text-gray-300 uppercase sm:text-xs'
        >
          Max fret
        </label>
        <div class='flex w-full'>
          <button
            type='button'
            data-step-target='coordinate-max-fret'
            data-step-direction='-1'
            aria-label='Decrease maximum fret'
            title='Decrease maximum fret'
            class='flex h-8 w-8 shrink-0 items-center justify-center rounded-l-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
          >
            <Icon name='material-symbols:remove' class='w-5 h-5' />
          </button>
          <input
            type='number'
            id='coordinate-max-fret'
            min='0'
            max='24'
            step='1'
            value='24'
            onchange='updateCoordinateMaxFret(this.value)'
            class='number-stepper-input min-w-0 w-full appearance-none bg-deep-charcoal border-y border-purple-800/60 p-1 text-center text-xs font-medium text-amber-300 focus:z-10 focus:outline-none focus:border-amber-400'
          />
          <button
            type='button'
            data-step-target='coordinate-max-fret'
            data-step-direction='1'
            aria-label='Increase maximum fret'
            title='Increase maximum fret'
            class='flex h-8 w-8 shrink-0 items-center justify-center rounded-r-md border border-purple-800/60 bg-deep-charcoal text-gray-300 transition-colors hover:bg-purple-900/70 hover:text-amber-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400'
          >
            <Icon name='material-symbols:add' class='w-5 h-5' />
          </button>
        </div>
      </div>
    </div>

    <!-- Strings Selection -->
    <div class='mb-4'>
      <div class='mb-2 flex items-center justify-between'>
        <span class='text-xs font-semibold uppercase tracking-wide text-gray-300'
          >Configure Strings</span
        >
        <div class='space-x-2 text-xs'>
          <button
            type='button'
            onclick='toggleAllCoordinateStrings(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            type='button'
            onclick='toggleAllCoordinateStrings(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>
      <div id='coordinate-string-checkboxes' class='grid grid-cols-3 gap-2'></div>
    </div>

    <!-- Notes Selection -->
    <div class='mb-2'>
      <div class='mb-2 flex items-center justify-between'>
        <span class='text-xs font-semibold uppercase tracking-wide text-gray-300'
          >Configure Notes</span
        >
        <div class='space-x-2 text-xs'>
          <button
            type='button'
            onclick='toggleAllCoordinateNotes(true)'
            class='text-amber-400 hover:underline cursor-pointer'>All</button
          >
          <span class='text-gray-500'>/</span>
          <button
            type='button'
            onclick='toggleAllCoordinateNotes(false)'
            class='text-amber-400 hover:underline cursor-pointer'>None</button
          >
        </div>
      </div>
      <div id='coordinate-note-checkboxes' class='grid grid-cols-3 gap-2'></div>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      startCoordinateQuiz: () => void;
      nextCoordinateQuestion: () => void;
      updateCoordinateQuestionCount: (val: string) => void;
      updateCoordinateMaxFret: (val: string) => void;
      updateCoordinateStringState: (index: number, checked: boolean) => void;
      updateCoordinateNoteState: (index: number, checked: boolean) => void;
      toggleAllCoordinateStrings: (checked: boolean) => void;
      toggleAllCoordinateNotes: (checked: boolean) => void;
    }
  }

  const coordinateNotes = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
  const openStringMidi = [40, 45, 50, 55, 59, 64];
  const stringNames = ['E', 'A', 'D', 'G', 'B', 'e'];
  const notePitchClasses: Record<string, number> = {
    C: 0,
    'C#': 1,
    Db: 1,
    D: 2,
    'D#': 3,
    Eb: 3,
    E: 4,
    F: 5,
    'F#': 6,
    Gb: 6,
    G: 7,
    'G#': 8,
    Ab: 8,
    A: 9,
    'A#': 10,
    Bb: 10,
    B: 11,
  };

  const questionLabel = document.getElementById('coordinate-question');
  const progressLabel = document.getElementById('coordinate-progress');
  const scoreLabel = document.getElementById('coordinate-score');
  const feedbackLabel = document.getElementById('coordinate-feedback');
  const answersContainer = document.getElementById('coordinate-answers');
  const questionArea = document.getElementById('coordinate-question-area');
  const resultsPanel = document.getElementById('coordinate-results');
  const finalScoreLabel = document.getElementById('coordinate-final-score');
  const startButton = document.getElementById('coordinate-start-btn');
  const startLabel = document.getElementById('coordinate-start-label');
  const nextButton = document.getElementById('coordinate-next-btn') as HTMLButtonElement | null;
  const nextLabel = document.getElementById('coordinate-next-label');

  let totalQuestions = getQuestionCount();
  let answeredQuestions = 0;
  let score = 0;
  let correctAnswer = '';
  let hasAnswered = false;

  function getQuestionCount(): number {
    const savedCount = Number(localStorage.getItem('v1-bfx-coordinate-question-count') ?? 10);
    return Number.isInteger(savedCount) ? Math.max(1, Math.min(50, savedCount)) : 10;
  }

  function getQuestionPool(): { stringIndex: number; fret: number; pitchClass: number }[] {
    const maxFretValue = Number(localStorage.getItem('v1-bfx-coordinate-max-fret') ?? 24);
    const maxFret = Number.isInteger(maxFretValue) ? Math.max(0, Math.min(24, maxFretValue)) : 24;

    let selectedStringIndexes = openStringMidi.map((_, index) => index);
    let selectedNotes = coordinateNotes;

    try {
      const savedStrings = localStorage.getItem('v1-bfx-coordinate-strings-state');
      if (savedStrings !== null) {
        const stringStates = JSON.parse(savedStrings) as { checked?: boolean }[];
        selectedStringIndexes = stringStates.flatMap((stringState, index) =>
          stringState?.checked && index < openStringMidi.length ? [index] : [],
        );
      }

      const savedNotes = localStorage.getItem('v1-bfx-coordinate-notes-state');
      if (savedNotes !== null) {
        const noteStates = JSON.parse(savedNotes) as { label?: string; checked?: boolean }[];
        selectedNotes = noteStates
          .filter(noteState => noteState.checked && noteState.label)
          .map(noteState => noteState.label ?? '');
      }
    } catch {
      selectedStringIndexes = openStringMidi.map((_, index) => index);
      selectedNotes = coordinateNotes;
    }

    const allowedPitchClasses = new Set(
      selectedNotes
        .map(note => notePitchClasses[note.replace('♯', '#').replace('♭', 'b')])
        .filter((pitchClass): pitchClass is number => pitchClass !== undefined),
    );
    const questionPool: { stringIndex: number; fret: number; pitchClass: number }[] = [];

    selectedStringIndexes.forEach(stringIndex => {
      for (let fret = 0; fret <= maxFret; fret++) {
        const pitchClass = (openStringMidi[stringIndex] + fret) % 12;
        if (allowedPitchClasses.has(pitchClass))
          questionPool.push({ stringIndex, fret, pitchClass });
      }
    });

    return questionPool;
  }

  function renderQuestion(): void {
    if (!questionLabel || !progressLabel || !scoreLabel || !feedbackLabel || !answersContainer)
      return;

    const questionPool = getQuestionPool();
    if (questionPool.length === 0) {
      progressLabel.textContent = 'No questions available';
      scoreLabel.textContent = `Score ${score}`;
      questionLabel.textContent = 'No matching notes on the selected strings';
      feedbackLabel.textContent = 'Choose more notes or strings, or raise Max Fret in Settings.';
      answersContainer.replaceChildren();
      nextButton?.classList.add('hidden');
      return;
    }

    const availableAnswers = Array.from(
      new Set(questionPool.map(({ pitchClass }) => coordinateNotes[pitchClass])),
    );
    if (availableAnswers.length < 2) {
      progressLabel.textContent = 'More notes needed';
      scoreLabel.textContent = `Score ${score}`;
      questionLabel.textContent = 'Select at least two notes for answer choices';
      feedbackLabel.textContent = 'Choose another reachable note in Fret Quiz Settings.';
      answersContainer.replaceChildren();
      nextButton?.classList.add('hidden');
      return;
    }

    const question = questionPool[Math.floor(Math.random() * questionPool.length)];
    const { stringIndex, fret, pitchClass } = question;
    correctAnswer = coordinateNotes[pitchClass];
    answeredQuestions += 1;
    hasAnswered = false;

    progressLabel.textContent = `${answeredQuestions} of ${totalQuestions}`;
    scoreLabel.textContent = `Score ${score}`;
    questionLabel.innerHTML = `<span class="text-stone-400">Fret</span> <span class="text-amber-400">${fret}</span> <span class="font-light text-gray-500">on</span> <span class="text-cyan-400">${stringNames[stringIndex]}</span> <span class="text-stone-400">String</span>`;
    feedbackLabel.textContent = '';

    const distractors = availableAnswers
      .filter(note => note !== correctAnswer)
      .sort(() => Math.random() - 0.5)
      .slice(0, 3);
    const choices = [correctAnswer, ...distractors];
    choices.sort(() => Math.random() - 0.5);
    answersContainer.innerHTML = choices
      .map(
        note =>
          `<button type="button" data-coordinate-answer="${note}" class="cursor-pointer rounded-md border border-purple-900/50 bg-deep-purple/70 px-4 py-3 text-lg font-bold text-amber-300 transition-colors hover:border-amber-400/70 hover:bg-purple-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400">${note}</button>`,
      )
      .join('');

    if (nextButton) {
      nextButton.disabled = true;
      if (nextLabel) nextLabel.textContent = 'Next question';
      nextButton.classList.remove('hidden');
    }
  }

  function finishQuiz(): void {
    if (!questionLabel || !progressLabel || !scoreLabel || !feedbackLabel || !answersContainer)
      return;

    progressLabel.textContent = 'Done';
    scoreLabel.textContent = `${score} / ${totalQuestions}`;
    if (finalScoreLabel) finalScoreLabel.textContent = `${score} / ${totalQuestions}`;
    if (questionArea) questionArea.style.display = 'none';
    answersContainer.replaceChildren();
    answersContainer.style.display = 'none';
    if (resultsPanel) resultsPanel.style.display = 'block';
    if (startLabel) startLabel.textContent = 'Play again';
    nextButton?.classList.add('hidden');
  }

  answersContainer?.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const answerButton = target.closest<HTMLButtonElement>('[data-coordinate-answer]');
    if (!answerButton || hasAnswered) return;

    hasAnswered = true;
    const isCorrect = answerButton.dataset.coordinateAnswer === correctAnswer;
    if (isCorrect) score += 1;

    answersContainer
      .querySelectorAll<HTMLButtonElement>('[data-coordinate-answer]')
      .forEach(button => {
        button.disabled = true;
        if (button.dataset.coordinateAnswer === correctAnswer) {
          button.className =
            'cursor-not-allowed rounded-md border border-green-400 bg-green-500/20 px-4 py-3 text-lg font-bold text-green-200';
        } else if (button === answerButton) {
          button.className =
            'cursor-not-allowed rounded-md border border-red-400 bg-red-500/20 px-4 py-3 text-lg font-bold text-red-200';
        } else {
          button.classList.add('opacity-50');
        }
      });

    if (scoreLabel) scoreLabel.textContent = `Score ${score}`;
    if (answeredQuestions === totalQuestions) {
      if (nextButton) {
        if (nextLabel) nextLabel.textContent = 'See results';
        nextButton.disabled = false;
        nextButton.classList.remove('hidden');
      }
      return;
    }

    if (nextButton) {
      if (nextLabel) nextLabel.textContent = 'Next question';
      nextButton.disabled = false;
      nextButton.classList.remove('hidden');
    }
  });

  startButton?.addEventListener('click', () => {
    totalQuestions = getQuestionCount();
    answeredQuestions = 0;
    score = 0;
    if (questionArea) questionArea.style.display = 'flex';
    if (answersContainer) answersContainer.style.display = 'grid';
    if (resultsPanel) resultsPanel.style.display = 'none';
    if (startLabel) startLabel.textContent = 'Restart';
    startButton.querySelector('.coordinate-start-play')?.classList.add('hidden');
    startButton.querySelector('.coordinate-start-restart')?.classList.remove('hidden');
    nextButton?.classList.add('hidden');
    renderQuestion();
  });

  nextButton?.addEventListener('click', () => {
    if (answeredQuestions >= totalQuestions) finishQuiz();
    else renderQuestion();
  });
</script>

<script>
  interface NoteConfig {
    label: string;
    checked: boolean;
  }

  interface StringConfig {
    label: string;
    name: string;
    checked: boolean;
  }

  const defaultCoordinateNotes: NoteConfig[] = [
    { label: 'A', checked: true },
    { label: 'A♯', checked: true },
    { label: 'B♭', checked: true },
    { label: 'B', checked: true },
    { label: 'C', checked: true },
    { label: 'C♯', checked: true },
    { label: 'D♭', checked: true },
    { label: 'D', checked: true },
    { label: 'D♯', checked: true },
    { label: 'E♭', checked: true },
    { label: 'E', checked: true },
    { label: 'F', checked: true },
    { label: 'F♯', checked: true },
    { label: 'G♭', checked: true },
    { label: 'G', checked: true },
    { label: 'G♯', checked: true },
    { label: 'A♭', checked: true },
  ];

  const defaultCoordinateStrings: StringConfig[] = [
    { label: 'E', name: 'E', checked: true },
    { label: 'A', name: 'A', checked: true },
    { label: 'D', name: 'D', checked: true },
    { label: 'G', name: 'G', checked: true },
    { label: 'B', name: 'B', checked: true },
    { label: 'e', name: 'e', checked: true },
  ];

  let coordinateNotesState: NoteConfig[] = loadCoordinateState(
    'v1-bfx-coordinate-notes-state',
    defaultCoordinateNotes,
  );
  let coordinateStringsState: StringConfig[] = loadCoordinateState(
    'v1-bfx-coordinate-strings-state',
    defaultCoordinateStrings,
  );

  let coordinateQuestionCountSetting = Math.max(
    1,
    Math.min(
      50,
      parseInt(localStorage.getItem('v1-bfx-coordinate-question-count') || '10', 10) || 10,
    ),
  );

  let coordinateMaxFretSetting = Math.max(
    0,
    Math.min(24, parseInt(localStorage.getItem('v1-bfx-coordinate-max-fret') || '24', 10) || 24),
  );

  function loadCoordinateState<T>(key: string, fallback: T): T {
    try {
      const saved = localStorage.getItem(key);
      return saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(fallback));
    } catch {
      return JSON.parse(JSON.stringify(fallback));
    }
  }

  function saveCoordinateState(key: string, data: unknown): void {
    try {
      localStorage.setItem(key, JSON.stringify(data));
    } catch (error) {
      console.error('Failed to save coordinate state to localStorage', error);
    }
  }

  function renderCheckboxesIntoColumns(
    items: NoteConfig[],
    updateFnName: string,
    containerId: string,
  ): void {
    const container = document.getElementById(containerId);
    if (!container) return;

    container.innerHTML = '';
    const numCols = 3;
    const colLists: { item: NoteConfig; originalIndex: number }[][] = Array.from(
      { length: numCols },
      () => [],
    );
    const itemsPerCol = Math.ceil(items.length / numCols);

    items.forEach((item, idx) => {
      const colIdx = Math.floor(idx / itemsPerCol);
      colLists[colIdx]?.push({ item, originalIndex: idx });
    });

    colLists.forEach(colItems => {
      let colHtml = `<div class="flex flex-col gap-2">`;
      colItems.forEach(({ item, originalIndex }) => {
        colHtml += `
        <label class="flex items-center gap-2 bg-deep-charcoal/60 p-2 rounded border border-purple-900/40 cursor-pointer hover:border-purple-700">
          <input type="checkbox" ${
            item.checked ? 'checked' : ''
          } onchange="${updateFnName}(${originalIndex}, this.checked)" class="bof-checkbox bof-checkbox--standard">
          <span class="text-xs font-medium text-gray-200 cursor-pointer">${item.label}</span>
        </label>
      `;
      });
      colHtml += `</div>`;
      container.innerHTML += colHtml;
    });
  }

  function renderCoordinateSettings(): void {
    const stringContainer = document.getElementById('coordinate-string-checkboxes');

    if (stringContainer) {
      stringContainer.innerHTML = coordinateStringsState
        .map(
          (stringConfig, index) => `
          <label class="flex items-center gap-2 bg-deep-charcoal/60 p-2 rounded border border-purple-900/40 cursor-pointer hover:border-purple-700">
            <input type="checkbox" ${
              stringConfig.checked ? 'checked' : ''
            } onchange="updateCoordinateStringState(${index}, this.checked)" class="bof-checkbox bof-checkbox--standard">
            <span class="text-xs font-medium text-gray-200 cursor-pointer">${stringConfig.label}</span>
          </label>
        `,
        )
        .join('');
    }

    // Render note checkboxes in 3 vertical columns
    renderCheckboxesIntoColumns(
      coordinateNotesState,
      'updateCoordinateNoteState',
      'coordinate-note-checkboxes',
    );

    const questionCountInput = document.getElementById(
      'coordinate-question-count',
    ) as HTMLInputElement | null;
    const maxFretInput = document.getElementById('coordinate-max-fret') as HTMLInputElement | null;

    if (questionCountInput) questionCountInput.value = coordinateQuestionCountSetting.toString();
    if (maxFretInput) maxFretInput.value = coordinateMaxFretSetting.toString();
  }

  window.updateCoordinateQuestionCount = (val: string): void => {
    const parsed = parseInt(val, 10);
    coordinateQuestionCountSetting = Number.isNaN(parsed) ? 10 : Math.max(1, Math.min(50, parsed));
    localStorage.setItem(
      'v1-bfx-coordinate-question-count',
      coordinateQuestionCountSetting.toString(),
    );
  };

  window.updateCoordinateMaxFret = (val: string): void => {
    const parsed = parseInt(val, 10);
    coordinateMaxFretSetting = Number.isNaN(parsed) ? 24 : Math.max(0, Math.min(24, parsed));
    localStorage.setItem('v1-bfx-coordinate-max-fret', coordinateMaxFretSetting.toString());
  };

  window.updateCoordinateStringState = (index: number, checked: boolean): void => {
    if (!coordinateStringsState[index]) return;
    coordinateStringsState[index].checked = checked;
    saveCoordinateState('v1-bfx-coordinate-strings-state', coordinateStringsState);
  };

  window.updateCoordinateNoteState = (index: number, checked: boolean): void => {
    if (!coordinateNotesState[index]) return;
    coordinateNotesState[index].checked = checked;
    saveCoordinateState('v1-bfx-coordinate-notes-state', coordinateNotesState);
  };

  window.toggleAllCoordinateStrings = (checked: boolean): void => {
    coordinateStringsState.forEach(stringConfig => (stringConfig.checked = checked));
    saveCoordinateState('v1-bfx-coordinate-strings-state', coordinateStringsState);
    renderCoordinateSettings();
  };

  window.toggleAllCoordinateNotes = (checked: boolean): void => {
    coordinateNotesState.forEach(noteConfig => (noteConfig.checked = checked));
    saveCoordinateState('v1-bfx-coordinate-notes-state', coordinateNotesState);
    renderCoordinateSettings();
  };

  renderCoordinateSettings();
</script>
