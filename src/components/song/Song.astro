import type { TSong } from '#types/song';

import SongHeader from '#components/song/Header.astro';
import SongNotes from './Notes.astro';
import SongChordsList from '#components/song/ChordsLists.astro';
import SongSections from '#components/song/sections/Sections.astro';
import { Icon } from 'astro-icon/components';

interface Props extends TSong {
  directory: string;
}

const props = Astro.props;

import type { TChord } from '#types/chord';
import guitarChordsIndexData from '#public/chords/index.json';
import ukuleleChordsIndexData from '#public/chords/ukulele/index.json';
const instrument = props.instrument ?? 'guitar';
const chordsIndex = (
  instrument === 'ukulele' ? ukuleleChordsIndexData.index : guitarChordsIndexData.index
) as Record<string, TChord>;
---

<div
  id='song-viewport-container'
  class='w-full min-h-dvh overflow-y-auto bg-(--theme-page) md:p-3 flex flex-col items-center justify-start overflow-x-hidden'
>
  <div
    class='rounded-xl bg-(--theme-surface) md:p-4 min-h-dvh w-full max-w-5xl flex flex-col justify-between gap-6'
  >
    <div>
      <SongHeader
        directory={props.directory}
        instrument={instrument}
        title={props.title}
        artists={props.artists}
        capo={props.capo}
        type={props.type}
        contributors={props.contributors}
        lyrics={props.lyrics}
        pdf={props.pdf}
        lyricsShown={false}
        res={props.res}
      />

      <div class='rounded-xl bg-(--theme-black)/20 md:p-3 mt-3 relative'>
        <div class='absolute right-4 -top-8'>
          <a
            href=`${import.meta.env.BASE_URL}index.html`
            data-resume-home
            class='block w-full h-full hover:opacity-80 transition-opacity'
          >
            <Icon
              name='material-symbols:library-music'
              class='w-[22px] h-[22px] text-(--theme-accent-strong)/80'
            />
          </a>
        </div>

        <SongNotes notes={props.notes} />
        <SongChordsList chordIDs={props.chordIDs} chordsIndex={chordsIndex} type={instrument} />

        <SongSections
          chordsIndex={chordsIndex}
          chordType={instrument}
          songSettings={{
            display: {
              strummingPattern: true,
              chordTimes: true,
              chordTimesOne: true,
            },
          }}
          sections={props.sections}
          order={props.order}
          strumms={props.strumms}
          showLyrics={false}
          lyrics={[]}
        />
      </div>
    </div>

  </div>
</div>

<script>
  import {
    applySongSettings,
    readSongSettings,
    SONG_SETTINGS_STORAGE_KEY,
  } from './song-settings';

  function updateSongSettings() {
    try {
      applySongSettings(document, readSongSettings());
    } catch (error) {
      console.error('Failed to apply saved song settings.', error);
    }
  }

  updateSongSettings();
  document.addEventListener('astro:after-swap', updateSongSettings);
  window.addEventListener('storage', event => {
    if (event.key === SONG_SETTINGS_STORAGE_KEY) updateSongSettings();
  });
  window.addEventListener('song-settings-changed', updateSongSettings);
</script>
