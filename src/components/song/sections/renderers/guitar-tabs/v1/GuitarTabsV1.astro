import type { TGTabV1SectionData } from '#types/song';
import type { TChordInstrument } from '#types/chord';
import type { TGuitarString, TUkuleleString } from '#types/common';

interface Props {
  data: TGTabV1SectionData;
  instrument?: TChordInstrument;
}

const { data, instrument = 'guitar' } = Astro.props;

type TFretNumber = number | string;
type TStringKey = TGuitarString | TUkuleleString;

type TDisplayChord = {
  name: string;
  offset: number;
};

type TStringToFrets = Record<TStringKey, TFretNumber[]>;

const tuningStrings: TStringKey[] =
  instrument === 'ukulele' ? ['A', 'E', 'C', 'G'] : ['e', 'B', 'G', 'D', 'A', 'E'];

const parseItems = (items: string): { stringsToFrets: TStringToFrets; chords: TDisplayChord[] } => {
  const stringsToFrets: TStringToFrets = {
    C: ['|'] as TFretNumber[],
    E: ['|'] as TFretNumber[],
    A: ['|'] as TFretNumber[],
    D: ['|'] as TFretNumber[],
    G: ['|'] as TFretNumber[],
    B: ['|'] as TFretNumber[],
    e: ['|'] as TFretNumber[],
  };
  const chords: TDisplayChord[] = [];
  const asValues = tuningStrings.map(stringName => stringsToFrets[stringName]);

  let chordOffset = 0;
  if (items.trim()) {
    items.trim().split(/\s+/).forEach((item, index) => {
      if (item === '-' || item === '|') {
        asValues.forEach(entry => entry.push(item));
        chordOffset += 1;
        return;
      }

      if (item.charAt(0) === '[') {
        chords.push({ name: item.slice(1, item.length - 1), offset: chordOffset });
        return;
      }

      const entries = item.split('+').map((chord, chordIndex) => {
        const stringName = chord.charAt(0) as TStringKey;
        if (!tuningStrings.includes(stringName) || chord.length < 2) {
          console.error(`Invalid ${instrument} tab item-${index}+${chordIndex}: "${chord}"`);
          return undefined;
        }
        return { stringName, fret: chord.slice(1) };
      });

      if (entries.some(entry => entry === undefined)) return;

      const validEntries = entries.filter(entry => entry !== undefined);
      const pushed = new Set<TStringKey>();
      let fillLength = 0;
      validEntries.forEach(({ stringName, fret }) => {
        stringsToFrets[stringName].push(fret);
        pushed.add(stringName);
        fillLength = Math.max(fillLength, fret.length);
      });

      asValues.forEach((entry, stringIndex) => {
        const stringName = tuningStrings[stringIndex];
        if (pushed.has(stringName)) {
          const localFilled = fillLength - entry[entry.length - 1].toString().length;
          if (localFilled > 0) entry.push('-'.repeat(localFilled));
        } else {
          entry.push('-'.repeat(fillLength));
        }
      });
      chordOffset += fillLength;
    });
  }

  asValues.forEach(arr => arr.push('|'));

  return { stringsToFrets, chords };
};

const { stringsToFrets, chords } = parseItems(data);

// Process the display chords inline inside the template mapping
const mappedChords = chords
  .map((chord, index) => {
    if (index === 0) {
      return chord.name;
    }
    return (
      ' '.repeat(chord.offset - chords[index - 1].offset - chords[index - 1].name.length) +
      chord.name
    );
  })
  .join('');
---

<div class='flex flex-col w-full overflow-x-auto text-[1.2em] text-[15.5px] mb-2'>
  <div class='min-w-max select-none'>
    {/* Mapped dynamic chord names above the tab lines */}
    {
      chords.length > 0 && (
        <p class='ml-[3ch] font-mono whitespace-pre text-(--theme-accent-text)/90'>{mappedChords}</p>
      )
    }

    {/* Tab lines pipeline */}
    {
      tuningStrings.map(stringName => (
        <div class='flex items-center'>
          <div class='sticky left-0 z-10 bg-(--theme-black)/50 px-1 font-bold font-mono text-(--theme-accent-text)/90'>
            {stringName}
          </div>
          <span class='bg-(--theme-black)/10 font-mono whitespace-pre text-(--theme-accent-text)/90'>
            {stringsToFrets[stringName].join('')}
          </span>
        </div>
      ))
    }

    {/* Section bottom break marker */}
    <!-- <hr class='mt-[1em] border-t border-solid border-(--theme-accent-text)/60' /> -->
  </div>
</div>
