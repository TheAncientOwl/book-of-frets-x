import { Icon } from 'astro-icon/components';
import NavigationList from '#components/app-menu/NavigationList.astro';
---

<!-- Floating Trigger Button -->
<button
  id='menu-trigger-btn'
  aria-label='App Menu'
  class='fixed top-4 left-4 z-[200] w-[45px] h-[45px] p-[3px] rounded-[10px]
        border border-solid border-neon-purple cursor-pointer
        transition-colors duration-200
        bg-deep-purple hover:bg-black/40
        text-amber-300/90'
>
  <img
    src={`${import.meta.env.BASE_URL}logo.svg`}
    alt='Book of Frets theme logo'
    width='39'
    height='39'
    class='w-full h-full object-cover rounded-[7px]'
  />
</button>

<!-- The Drawer Dialog Scaffolding -->
<dialog
  id='app-menu-drawer'
  class='fixed left-0 m-0 top-0 bottom-0 w-full max-w-xs h-dvh max-h-none
        flex flex-col
        bg-deep-purple p-0 shadow-2xl
        transition-transform duration-300 -translate-x-full
        backdrop:bg-black/60 open:translate-x-0'
>
  <!-- Header -->
  <header
    class='flex items-center justify-between p-4 sticky top-0 z-[110] bg-deep-purple border-b border-neon-purple/20'
  >
    <div class='flex items-center gap-2'>
      <img
        src={`${import.meta.env.BASE_URL}logo.svg`}
        alt='Book of Frets Logo'
        width='25'
        height='25'
        class='max-w-[25px]'
      />
      <span class='font-bold text-amber-300/90 text-xl'>Book Of Frets</span>
    </div>
    <button
      id='menu-close-btn'
      class='p-1 text-amber-300/90 hover:text-magenta transition-colors cursor-pointer'
      aria-label='Close menu'
    >
      <Icon name='material-symbols:close' class='w-6 h-6' />
    </button>
  </header>

  <!-- Scrollable Content Area -->
  <div class='flex-1 overflow-y-auto p-4'>
    <NavigationList />
  </div>

  <!-- Footer -->
  <footer
    class='p-4 border-t border-solid border-neon-purple/20 flex justify-center bg-deep-purple'
  >
    <a
      href='https://github.com/TheAncientOwl/book-of-frets-x/blob/main/LICENSE'
      target='_blank'
      rel='noopener noreferrer'
      class='flex items-center gap-1 text-sm text-amber-300/90 hover:text-magenta transition-colors duration-200'
    >
      Copyright <Icon name='material-symbols:copyright-outline' class='w-4 h-4' /> 2026 BookOfFrets
    </a>
  </footer>
</dialog>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
  const lastPageKey = 'v1-bfx-last-visited-page';
  const explicitHomeKey = 'v1-bfx-explicit-home-navigation';
  const basePath = new URL(baseUrl, window.location.origin).pathname;
  const currentPath = window.location.pathname;
  const homePaths = new Set([basePath, `${basePath}index.html`]);
  const isHome = homePaths.has(currentPath);
  const isNotFound = currentPath.endsWith('/404') || currentPath.endsWith('/404.html');

  document.addEventListener(
    'click',
    event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-resume-home]')) {
        sessionStorage.setItem(explicitHomeKey, 'true');
      }
    },
    true,
  );

  if (isHome) {
    const navigationType = performance.getEntriesByType('navigation')[0]?.type;
    const skipResume =
      sessionStorage.getItem(explicitHomeKey) === 'true' || navigationType === 'back_forward';
    sessionStorage.removeItem(explicitHomeKey);

    if (!skipResume) {
      const savedPage = localStorage.getItem(lastPageKey);
      if (savedPage) {
        try {
          const destination = new URL(savedPage, window.location.origin);
          const isInBase = basePath === '/' || destination.pathname.startsWith(basePath);
          const destinationIsHome = homePaths.has(destination.pathname);
          const destinationIsNotFound =
            destination.pathname.endsWith('/404') || destination.pathname.endsWith('/404.html');

          if (
            destination.origin === window.location.origin &&
            isInBase &&
            !destinationIsHome &&
            !destinationIsNotFound
          ) {
            window.location.replace(
              `${destination.pathname}${destination.search}${destination.hash}`,
            );
          } else {
            localStorage.removeItem(lastPageKey);
          }
        } catch {
          localStorage.removeItem(lastPageKey);
        }
      }
    }
  } else if (!isNotFound && (basePath === '/' || currentPath.startsWith(basePath))) {
    localStorage.setItem(
      lastPageKey,
      `${window.location.pathname}${window.location.search}${window.location.hash}`,
    );
  }
</script>

<script>
  const drawer = document.getElementById('app-menu-drawer') as HTMLDialogElement;
  const triggerBtn = document.getElementById('menu-trigger-btn');
  const closeBtn = document.getElementById('menu-close-btn');

  // --- Drawer Open / Close Logic ---
  triggerBtn?.addEventListener('click', () => {
    drawer?.showModal();
    document.body.style.overflow = 'hidden'; // Stop background scroll
  });

  const closeDrawer = () => {
    drawer?.close();
    document.body.style.overflow = '';
  };

  closeBtn?.addEventListener('click', closeDrawer);

  // Close when clicking backdrop shadow area
  drawer?.addEventListener('click', e => {
    if (e.target === drawer) closeDrawer();
  });

  // Automatically close the drawer when a navigation item is clicked
  window.addEventListener('nav-item-clicked', () => {
    closeDrawer();
  });
</script>
