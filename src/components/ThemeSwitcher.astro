import themeConfig from '../data/theme-config';

const { themes } = themeConfig;
---

<section aria-label='Appearance'>
  <div class='theme-scheme-tabs' role='tablist' aria-label='Filter themes by appearance'>
    <button
      class='theme-scheme-tab'
      type='button'
      role='tab'
      id='dark-themes-tab'
      aria-controls='theme-options'
      aria-selected='false'
      data-theme-scheme-tab='dark'
    >
      Dark
    </button>
    <button
      class='theme-scheme-tab'
      type='button'
      role='tab'
      id='light-themes-tab'
      aria-controls='theme-options'
      aria-selected='false'
      data-theme-scheme-tab='light'
    >
      Light
    </button>
  </div>
  <div class='theme-options' id='theme-options' role='tabpanel' aria-labelledby='dark-themes-tab'>
    {
      themes.map(theme => (
        <button
          class='theme-option'
          type='button'
          data-theme-option={theme.id}
          data-color-scheme={theme.colorScheme}
          aria-pressed='false'
          style={`--preview-page: ${theme.colors.page}; --preview-surface: ${theme.colors.surface}; --preview-accent: ${theme.colors.accent}; --preview-text: ${theme.colors.text};`}
        >
          <span class='theme-preview' aria-hidden='true'>
            <span class='theme-swatch' />
            <span class='theme-swatch' />
            <span class='theme-swatch' />
          </span>
          <span class='theme-name'>{theme.name}</span>
          <span class='theme-scheme'>{theme.colorScheme} appearance</span>
        </button>
      ))
    }
  </div>
</section>

<script>
  let selectedScheme = 'dark';

  function syncThemeOptions(followActiveTheme = true) {
    const activeTheme = document.documentElement.getAttribute('data-theme');
    const activeScheme = document.documentElement.getAttribute('data-color-scheme');
    if (followActiveTheme && (activeScheme === 'light' || activeScheme === 'dark')) {
      selectedScheme = activeScheme;
    }

    document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach(button => {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === activeTheme));
      button.hidden = button.dataset.colorScheme !== selectedScheme;
    });

    document.querySelectorAll<HTMLButtonElement>('[data-theme-scheme-tab]').forEach(tab => {
      const selected = tab.dataset.themeSchemeTab === selectedScheme;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    document
      .querySelector('.theme-options')
      ?.setAttribute(
        'aria-labelledby',
        selectedScheme === 'light' ? 'light-themes-tab' : 'dark-themes-tab',
      );
  }

  function selectScheme(scheme) {
    if (scheme !== 'light' && scheme !== 'dark') return;
    selectedScheme = scheme;
    syncThemeOptions(false);
  }

  document.addEventListener('click', event => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const tab = target.closest<HTMLButtonElement>('[data-theme-scheme-tab]');
    if (tab?.dataset.themeSchemeTab) {
      selectScheme(tab.dataset.themeSchemeTab);
      return;
    }

    const button = target.closest<HTMLButtonElement>('[data-theme-option]');
    const theme = button?.dataset.themeOption;
    if (!button || !theme) return;

    document.dispatchEvent(
      new CustomEvent('book-of-frets:theme-change', {
        detail: { themeId: theme },
      }),
    );
    selectedScheme = button.dataset.colorScheme ?? selectedScheme;
    syncThemeOptions();

    try {
      localStorage.setItem('book-of-frets-theme', theme);
    } catch (error) {
      console.error('Unable to save the theme preference:', error);
    }
  });

  document.addEventListener('keydown', event => {
    const tab = event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>('[data-theme-scheme-tab]')
      : null;
    if (!tab) return;

    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight' || event.key === 'Home' || event.key === 'End') {
      event.preventDefault();
      const scheme = event.key === 'Home'
        ? 'dark'
        : event.key === 'End'
          ? 'light'
          : tab.dataset.themeSchemeTab === 'dark'
            ? 'light'
            : 'dark';
      selectScheme(scheme);
      document.querySelector<HTMLButtonElement>(`[data-theme-scheme-tab="${scheme}"]`)?.focus();
    }
  });

  syncThemeOptions();
  document.addEventListener('astro:after-swap', syncThemeOptions);
</script>

<style>
  .theme-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .theme-scheme-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 1rem 1rem;
    border-bottom: 1px solid var(--theme-surface-raised);
  }

  .theme-scheme-tab {
    border: 0;
    border-bottom: 3px solid transparent;
    padding: 0.75rem 1.25rem;
    background: transparent;
    color: var(--theme-muted);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .theme-scheme-tab[aria-selected='true'] {
    border-bottom-color: var(--theme-accent);
    color: var(--theme-accent-text);
  }

  .theme-scheme-tab:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: -2px;
  }

  .theme-option {
    display: flex;
    min-height: 8rem;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
    border: 2px solid var(--theme-surface-raised);
    border-radius: 0.75rem;
    padding: 1rem;
    background: var(--theme-surface);
    color: var(--theme-text);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 200ms,
      transform 200ms;
  }

  .theme-option[hidden] {
    display: none;
  }

  .theme-option:hover {
    transform: translateY(-2px);
  }

  .theme-option[aria-pressed='true'],
  .theme-option:hover {
    border-color: var(--preview-accent);
  }

  .theme-preview {
    display: flex;
    width: 100%;
    height: 2.5rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--preview-text) 25%, transparent);
    border-radius: 0.5rem;
    background: var(--preview-page);
  }

  .theme-swatch {
    flex: 1;
    background: var(--preview-surface);
  }

  .theme-swatch + .theme-swatch {
    border-left: 1px solid color-mix(in srgb, var(--preview-text) 25%, transparent);
  }

  .theme-swatch:nth-child(2) {
    background: var(--preview-accent);
  }

  .theme-swatch:nth-child(3) {
    background: var(--preview-text);
  }

  .theme-name {
    font-weight: 700;
  }

  .theme-scheme {
    color: var(--theme-muted);
    font-size: 0.75rem;
    text-transform: capitalize;
  }

  .theme-option:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 2px;
  }

  @media (min-width: 40.001rem) {
    .theme-options {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }
  }

  @media (max-width: 40rem) {
    .theme-preview {
      height: 1.5rem;
    }

    .theme-option {
      min-height: 7rem;
      padding: 0.75rem;
    }
  }
</style>
