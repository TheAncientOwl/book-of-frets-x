import Fret from './Fret.astro';
import type { TChord, TFret } from '#types/chord';
import type { TGuitarString, TUkuleleString } from '#types/common';
import ChordDisplay from '#components/song/sections/renderers/chords/v2/Display.astro';

interface Props extends TChord {
  class?: string;
  type?: 'guitar' | 'ukulele';
}

type TStringKey = TGuitarString | TUkuleleString;

const props = Astro.props;
const className = props.class || '';
const type = props.type || 'guitar';

const InstrumentStrings: TStringKey[] =
  type === 'guitar' ? (['E', 'A', 'D', 'G', 'B', 'e'] as const) : (['G', 'C', 'E', 'A'] as const);

const computeOpenFrets = (frets: TFret[]): boolean[] => {
  const out = InstrumentStrings.map(() => true);

  InstrumentStrings.forEach((stringName, stringIdx) => {
    for (const fret of frets) {
      if (fret[stringName as keyof TFret] !== undefined) {
        out[stringIdx] = false;
        break;
      }
    }
  });

  return out;
};

// Explicit type casting handles the strict Map constructor iterable requirements cleanly
const computedFretsData = props.frets.map(fret => {
  return new Map<TStringKey, number>(
    Object.entries(fret).map(([key, value]) => [key as TStringKey, value as number]),
  );
});
---

<div
  class={`w-[13em] p-[1em] rounded-[1em] text-[1em] border border-solid flex flex-col items-center relative bg-(--theme-surface-raised) border-(--theme-accent-text)/90 ${className}`}
>
  <!-- Heading / Title Layout -->
  <div
    class='relative flex justify-center items-center gap-[5px] text-[2.3em] font-bold text-center mb-1.5 text-(--theme-accent-text)/90 flex-row'
  >
    <ChordDisplay name={props.name} />

    {
      props.startFret && (
        <div class='absolute top-0 right-0 translate-x-full text-sm w-4 h-4 text-[0.45em] font-bold border border-solid rounded-full flex items-center justify-center bg-(--theme-surface) border-(--theme-accent-strong) text-(--theme-accent-text)/90'>
          {props.startFret}
        </div>
      )
    }
  </div>

  <!-- Frets Block Grid Container -->
  <div class='w-[11em] mt-[1.5em]'>
    <hr class='border-t border-solid border-(--theme-accent-text)/60' />

    {
      computedFretsData.map((stringToFingersMap, idx) => {
        return (
          <>
            <Fret
              stringsToFingers={stringToFingersMap}
              isOpenFret={idx !== 0 ? undefined : computeOpenFrets(props.frets)}
              type={type}
            />
            {idx < props.frets.length && <hr class='border-t border-solid border-(--theme-accent-text)/60' />}
          </>
        );
      })
    }
  </div>
</div>

<script>
  import {
    applySongSettings,
    readSongSettings,
    SONG_SETTINGS_STORAGE_KEY,
  } from '#components/song/song-settings';

  function applySavedChordSettings() {
    try {
      applySongSettings(document, readSongSettings());
    } catch (error) {
      console.error('Failed to apply saved chord settings.', error);
    }
  }

  applySavedChordSettings();
  document.addEventListener('astro:after-swap', applySavedChordSettings);
  window.addEventListener('storage', event => {
    if (event.key === SONG_SETTINGS_STORAGE_KEY) applySavedChordSettings();
  });
  window.addEventListener('song-settings-changed', applySavedChordSettings);
</script>
