 * @description Shared icon-only action button with accessible labeling.
 */

interface Props {
  id?: string;
  label: string;
  onclick?: string;
  title?: string;
}

const { id, label, onclick, title = label } = Astro.props;
---

<button
  type='button'
  id={id}
  onclick={onclick}
  title={title}
  aria-label={label}
  class='px-3 py-1.5 bg-(--theme-surface-hover) hover:bg-(--theme-surface-hover) text-xs font-semibold rounded-md transition-colors text-(--theme-muted) border border-(--theme-accent-strong) cursor-pointer flex items-center gap-1.5 shadow'
>
  <slot />
</button>
