import AppMenu from '#components/app-menu/AppMenu.astro';
import ThemeInitializer from '#components/ThemeInitializer.astro';
---

<!doctype html>
<html lang='en'>
  <head>
    <!-- Misc -->
    <meta charset='utf-8' />
    <link rel='manifest' href=`${import.meta.env.BASE_URL}favicon/site.webmanifest` />
    <meta name='viewport' content='width=device-width, initial-scale=1.0, viewport-fit=cover' />
    <meta name='apple-mobile-web-app-capable' content='yes' />
    <meta name='apple-mobile-web-app-status-bar-style' content='default' />
    <ThemeInitializer />

    <!-- Favicon -->
    <link
      id='dynamic-1'
      data-theme-favicon
      rel='icon'
      type='image/png'
      href=`${import.meta.env.BASE_URL}favicon/favicon-96x96.png`
      sizes='96x96'
    />
    <link
      id='dynamic-2'
      data-theme-favicon
      rel='icon'
      type='image/svg+xml'
      href=`${import.meta.env.BASE_URL}favicon/favicon.svg`
    />
    <link
      id='dynamic-3'
      data-theme-favicon
      rel='shortcut icon'
      href=`${import.meta.env.BASE_URL}favicon/favicon.ico`
    />
    <link
      id='dynamic-4'
      rel='apple-touch-icon'
      sizes='180x180'
      href=`${import.meta.env.BASE_URL}favicon/apple-touch-icon.png`
    />

    <!-- Description -->
    <meta
      name='description'
      content='Book Of Frets - Explore guitar chords, song sheets, and tutorials for guitar players. Find chord charts, song patterns, and learn new songs easily.'
    />

    <!-- Astro -->
    <meta name='generator' content={Astro.generator} />

    <!-- Title -->
    <title>𝐁𝐨𝐨𝐤 𝐎𝐟 𝐅𝐫𝐞𝐭𝐬</title>
  </head>
  <body>
    <AppMenu />
    <main>
      <slot />
    </main>
  </body>
</html>
